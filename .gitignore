# --- Datos ---
# La carpeta de entrada se versiona vacía: solo se conserva el .gitkeep
data/entrada/*
!data/entrada/.gitkeep
data/raw/
data/dataset/
data/.tmp_pipeline/
data/.pipeline_en_marcha/
# JSON de datos reales (los de configuración fuera de data/ sí se versionan)
data/**/*.json
# Datos que genera python -m api.preparar_datos a partir de los historiales (personales)
api/datos/

# --- MLflow (servidor local: entorno virtual, base de datos y artefactos) ---
mlruns/
mlflow.db
.venv-mlflow/

# --- Volúmenes y datos locales de Docker ---
docker/volumes/
docker/data/
*.env.local

# --- Varios ---
.DS_Store
Thumbs.db
__pycache__/
.ipynb_checkpoints/
.vscode/
.idea/

# --- Exportaciones de Spotify sin procesar (datos personales) ---
Spotify Extended Streaming History/
*Spotify*.zip
*spotify*.zip

# --- Entorno virtual de Python ---
.venv/

# Carpeta de demo de la web (copia de data/raw + modelo generado)
data/demo/
